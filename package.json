{
  "name": "chess69",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "android:setup": "bash scripts/setup-android.sh",
    "android:build": "bash scripts/build-android.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\" \"scripts/*.mjs\" && node scripts/format-function-blocks.mjs --write",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\" \"scripts/*.mjs\" && node scripts/format-function-blocks.mjs",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "npm run storybook:build && playwright test --config .storybook/playwright.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "storybook:dev": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "remeda": "^2.51.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@storybook/react-native-web-vite": "10.6.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.3",
    "storybook": "10.6.2",
    "typescript": "~6.0.3",
    "vite": "7.3.7"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ]
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
